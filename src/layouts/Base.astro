---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import displayFont from '@fontsource/familjen-grotesk/files/familjen-grotesk-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/public-sans/files/public-sans-latin-400-normal.woff2?url';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import WorldHost from '@/components/WorldHost.astro';
import { FULL_NAME, PERSON, SITE, CONTACT } from '@/config/site';
import { seedFor, visibleProjects } from '@/lib/projects';
import { paletteFor } from '@/lib/palettes';

interface Props {
  title?: string;
  description?: string;
  /** Page kind, read by the engine to pick a camera framing. */
  page: 'home' | 'work' | 'case' | 'about' | 'contact' | 'missing';
  /** Project slug on case-study pages. */
  slug?: string;
  /** Featured card index this page is about (case studies), or -1. */
  focus?: number;
  ogImage?: string;
}

const { title, description = SITE.description, page, slug, focus = -1, ogImage = '/og.png' } = Astro.props;

// The 3D cards: one per featured project, the same finish and relief as its DOM card.
const { featured } = await visibleProjects();
const worldData = {
  cards: featured.map((p, i) => ({
    slug: p.id,
    title: p.data.title,
    index: i,
    seed: seedFor(p),
    palette: paletteFor(p.id),
  })),
};
const fullTitle = title ? `${title} | ${FULL_NAME}` : SITE.title;
const origin = SITE.url.value;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogUrl = new URL(ogImage, origin).href;

const sameAs = CONTACT.filter((c) => !c.placeholder && c.href.startsWith('http')).map((c) => c.href);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: FULL_NAME,
  givenName: 'Ahmad',
  jobTitle: PERSON.role,
  description: SITE.description,
  url: origin,
  address: { '@type': 'PostalAddress', addressLocality: 'Islamabad', addressCountry: 'PK' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'National University of Sciences and Technology (NUST)' },
  worksFor: { '@type': 'Organization', name: PERSON.company },
  knowsAbout: [
    'Software engineering',
    'SaaS development',
    'Next.js',
    'React',
    'Node.js',
    'TypeScript',
    'PostgreSQL',
    'React Native',
    'AWS',
    'Google Cloud',
    'Workflow automation',
    'LLM integration',
    'Retrieval-augmented generation',
    'Multi-agent systems',
  ],
  ...(sameAs.length ? { sameAs } : {}),
};
---

<!doctype html>
<html lang={SITE.locale} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={page === 'case' ? 'article' : 'website'} />
    <meta property="og:site_name" content={FULL_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A field of machined pins shaped into a generative relief, beside the name Ahmad." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        if (window.__jsClass) return;
        window.__jsClass = true;
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.classList.add('js');
        });
      })();
    </script>

    <ClientRouter />
  </head>
  <body data-slug={slug} data-focus={focus}>
    <a class="skip-link" href="#main">Skip to content</a>
    <WorldHost />
    <canvas id="liquid" class="liquid" transition:persist="liquid" aria-hidden="true"></canvas>
    <script type="application/json" id="world-data" set:html={JSON.stringify(worldData)} />
    <SiteHeader current={page} />
    <main id="main" tabindex="-1" transition:name="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '@/scripts/world-gate';
    </script>
  </body>
</html>
