---
// Reviews: cards floating on an arc. The current card faces the reader; the others lean in from
// the sides and fade with distance. The ring turns by itself (motion/carousel.ts) and a card can
// be clicked to bring it forward. Without JavaScript the cards are a row that scrolls sideways.
// Nothing here is invented; see config/testimonials.ts for where each line comes from.
import Todo from './Todo.astro';
import { REVIEWS, REVIEWS_UNVERIFIED, UPWORK_REVIEWS } from '@/config/testimonials';
import { CONTACT } from '@/config/site';

const slides = [...REVIEWS, ...UPWORK_REVIEWS];
const upwork = CONTACT.find((c) => c.label === 'Upwork');
const pad = (n: number) => String(n).padStart(2, '0');
const initials = (name: string) =>
  name
    .split(' ')
    .map((w) => w[0])
    .join('')
    .slice(0, 2);
---

<section class="said" id="reviews" aria-labelledby="said-title">
  <header class="sec-head said-head page">
    <p class="label">Reviews</p>
    <h2 class="sec-title" id="said-title"><span class="dim">In their</span><span>words</span></h2>
  </header>

  <div class="car" data-carousel aria-roledescription="carousel" aria-label="Client reviews">
    <ul class="car-stage" role="list" data-car-track>
      {
        slides.map((s, i) => (
          <li class="card" style={`--i:${i}`}>
            <figure>
              <p class="stat">{s.stat}</p>
              <p class="cap">{s.cap}</p>
              <blockquote>“{s.text}”</blockquote>
              <figcaption>
                <span class="avatar" aria-hidden="true">
                  {initials(s.name)}
                </span>
                <span class="who">
                  <b>{s.name}</b>
                  <span>{s.role}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
    <div class="car-nav">
      <button type="button" class="car-btn" data-car-prev aria-label="Previous review">←</button>
      <p class="label car-count" aria-hidden="true"><span data-car-count>01</span> / {pad(slides.length)}</p>
      <button type="button" class="car-btn" data-car-next aria-label="Next review">→</button>
    </div>
  </div>

  <p class="label said-foot page">
    Top Rated on Upwork
    {upwork && !upwork.placeholder && <a href={upwork.href}>See the profile</a>}
    <Todo when={REVIEWS_UNVERIFIED} text="Verify wording" />
    <Todo when={UPWORK_REVIEWS.length === 0} text="Upwork reviews to add" />
  </p>
</section>

<style>
  .said {
    position: relative;
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-9);
    background: var(--color-bg);
    border-top: var(--hairline);
    overflow: hidden;
  }

  .said-head {
    justify-items: center;
    text-align: center;
  }

  .car {
    --cw: min(29rem, 80vw);
    display: grid;
    gap: var(--space-7);
  }

  /* Without JavaScript: a row that scrolls sideways and snaps. */
  .car-stage {
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--page-gutter);
  }

  .card {
    flex: none;
    box-sizing: border-box;
    width: var(--cw);
    scroll-snap-align: center;
  }

  .card figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    box-sizing: border-box;
    height: 100%;
    min-height: 24rem;
    margin: 0;
    padding: clamp(1.5rem, 3.4vw, 2.5rem);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .stat {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.125rem);
    font-weight: 800;
    line-height: 1;
    overflow-wrap: normal;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .cap {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .card blockquote {
    flex: 1;
    margin: var(--space-4) 0 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .card figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }

  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-trace);
    color: var(--color-bg);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .who {
    display: grid;
    gap: 0.1rem;
  }

  .who span {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .car-nav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
  }

  .car-btn {
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 1.125rem;
    cursor: pointer;
    transition:
      border-color var(--dur-med) var(--ease-out),
      background-color var(--dur-med) var(--ease-out),
      color var(--dur-med) var(--ease-out);
  }

  .car-btn:hover {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .car-count {
    min-width: 4.5rem;
    text-align: center;
    color: var(--color-ink-muted);
  }

  .car-count span {
    color: var(--color-trace-ink);
  }

  .said-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    color: var(--color-ink-muted);
  }

  .said-foot a {
    color: var(--color-ink);
    text-underline-offset: 0.4em;
    text-decoration-color: var(--color-trace);
  }

  /* With JavaScript: every card shares one cell and is placed on an arc by its distance from
     the current card. --d is that distance in cards (negative to the left), --a its size. */
  .car[data-live] .car-stage {
    display: grid;
    justify-items: center;
    overflow: visible;
    padding-inline: 0;
    perspective: 1700px;
    transform-style: preserve-3d;
  }

  .car[data-live] .card {
    --step: calc(var(--cw) * 0.76);
    grid-area: 1 / 1;
    z-index: var(--z, 1);
    opacity: max(0, calc(1 - var(--a, 0) * 0.34));
    transform: translateX(calc(var(--d, 0) * var(--step))) translateZ(calc(var(--a, 0) * -110px))
      rotateY(calc(var(--d, 0) * -15deg)) scale(calc(1 - var(--a, 0) * 0.08));
    /* Placed every frame by motion/carousel.ts, so no transition: the drift is the motion. */
    will-change: transform, opacity;
    cursor: pointer;
  }

  .car[data-live] .card[data-on] {
    cursor: default;
  }

  .car[data-live] .card[data-far] {
    opacity: 0;
    pointer-events: none;
  }

  .car[data-live] .card[data-jump] {
    transition: none;
  }

  .car[data-live] .car-nav {
    display: flex;
  }

  /* Each card drifts on its own slow rhythm, so the ring never sits dead still. */
  @media (prefers-reduced-motion: no-preference) {
    .car[data-live] .card figure {
      animation: drift 7s ease-in-out infinite;
      animation-delay: calc(var(--i) * -1.7s);
    }
  }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .car[data-live] .card {
      transition: none;
    }
  }
</style>
