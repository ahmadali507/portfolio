---
// Reviews: a centred carousel of client quotes that advances by itself (motion/carousel.ts).
// Nothing here is invented. Each slide is a line the client says in his recorded endorsement, and
// written Upwork reviews join the same carousel once their text is added (config/testimonials.ts).
// Without JavaScript the cards are a row the reader scrolls sideways.
import Todo from './Todo.astro';
import { ENDORSEMENT as E, UPWORK_REVIEWS } from '@/config/testimonials';
import { CONTACT } from '@/config/site';

const slides = [
  { text: E.pull, name: E.name, meta: E.role, check: E.placeholder },
  ...E.reasons.map((r) => ({ text: r.text, name: E.name, meta: E.role, check: E.placeholder })),
  { text: E.close, name: E.name, meta: E.role, check: E.placeholder },
  ...UPWORK_REVIEWS.map((r) => ({ text: r.text, name: r.client, meta: r.project, check: false })),
];
const upwork = CONTACT.find((c) => c.label === 'Upwork');
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="said" id="reviews" aria-labelledby="said-title">
  <header class="sec-head said-head page">
    <p class="label">Reviews</p>
    <h2 class="sec-title" id="said-title"><span class="dim">In their</span><span>words</span></h2>
  </header>

  <div class="car" data-carousel aria-roledescription="carousel" aria-label="Client reviews">
    <div class="car-view">
      <ul class="car-track" role="list" data-car-track>
        {
          slides.map((s) => (
            <li class="card">
              <figure>
                <blockquote>{s.text}</blockquote>
                <figcaption>
                  <span class="sq" aria-hidden="true" />
                  <span class="who">{s.name}</span>
                  <span class="label meta">{s.meta}</span>
                  <Todo when={s.check} text="Verify" />
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="car-nav">
      <button type="button" class="car-btn" data-car-prev aria-label="Previous review">←</button>
      <p class="label car-count" aria-hidden="true"><span data-car-count>01</span> / {pad(slides.length)}</p>
      <button type="button" class="car-btn" data-car-next aria-label="Next review">→</button>
    </div>
  </div>

  <p class="label said-foot page">
    Top Rated on Upwork
    {upwork && !upwork.placeholder && <a href={upwork.href}>See the profile</a>}
    <Todo when={UPWORK_REVIEWS.length === 0} text="Upwork reviews to add" />
  </p>
</section>

<style>
  .said {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-9);
    background: var(--color-bg);
    border-top: var(--hairline);
    overflow: hidden;
  }

  .said-head {
    justify-items: center;
    text-align: center;
  }

  .car {
    --cw: min(35rem, 78vw);
    display: grid;
    gap: var(--space-6);
  }

  /* Without JavaScript: a row that scrolls sideways and snaps. */
  .car-view {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--page-gutter);
  }

  .car-track {
    display: flex;
    gap: var(--space-5);
    width: max-content;
  }

  .card {
    box-sizing: border-box;
    width: var(--cw);
    scroll-snap-align: center;
  }

  .card figure {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    box-sizing: border-box;
    height: 100%;
    min-height: 19rem;
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: var(--hairline);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .card blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.5vw, 2.125rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .card figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .sq {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--color-trace);
  }

  .who {
    font-weight: 600;
  }

  .meta {
    color: var(--color-ink-muted);
  }

  .car-nav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
  }

  .car-btn {
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 1.125rem;
    cursor: pointer;
    transition:
      border-color var(--dur-med) var(--ease-out),
      background-color var(--dur-med) var(--ease-out),
      color var(--dur-med) var(--ease-out);
  }

  .car-btn:hover {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .car-count {
    min-width: 4.5rem;
    text-align: center;
    color: var(--color-ink-muted);
  }

  .car-count span {
    color: var(--color-trace-ink);
  }

  .said-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    color: var(--color-ink-muted);
  }

  .said-foot a {
    color: var(--color-ink);
    text-underline-offset: 0.4em;
    text-decoration-color: var(--color-trace);
  }

  /* With JavaScript: the track slides so the current card sits in the centre. */
  .car[data-live] .car-view {
    overflow: hidden;
    padding-inline: 0;
  }

  .car[data-live] .car-track {
    margin-left: 50%;
    transition: transform 900ms var(--ease-expo);
  }

  .car[data-live] .card {
    opacity: 0.3;
    transform: scale(0.92);
    transition:
      opacity 600ms var(--ease-out),
      transform 800ms var(--ease-expo);
  }

  .car[data-live] .card[data-on] {
    opacity: 1;
    transform: none;
  }

  .car[data-live] .car-nav {
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    .car[data-live] .car-track,
    .car[data-live] .card {
      transition: none;
    }
  }
</style>
