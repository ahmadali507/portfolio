---
// A project's screenshots under a spotlight. The screen rests dimmed and drained of color; a light
// moves to the part that matters, names it, and moves on to the next screen (motion/spotlight.ts).
// While the pointer is over it, the light follows the pointer and the screen does not change.
//
// Two copies of the same image: the base is dimmed, the lit copy is masked to the light. Without
// JavaScript the lit copy shows in full and nothing moves. Projects without screenshots fall back
// to the generated relief.
import ProjectVisual from './ProjectVisual.astro';
import { labelFor, shotsFor } from '@/lib/shots';

interface Props {
  slug: string;
  title: string;
  pattern: number;
  seed: number;
  eager?: boolean;
}
const { slug, title, pattern, seed, eager = false } = Astro.props;
const shots = shotsFor(slug);
const data = shots.map((s, i) => ({
  src: s.src,
  w: s.width,
  h: s.height,
  focus: s.focus,
  label: labelFor(slug, i),
  alt: `${title}: ${s.alt}`,
}));
const first = data[0];
---

{
  first ? (
    <div class="spot" data-spot data-shots={JSON.stringify(data)}>
      <img
        class="spot-img spot-base"
        src={first.src}
        alt=""
        aria-hidden="true"
        width={first.w}
        height={first.h}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      <img
        class="spot-img spot-lit"
        src={first.src}
        alt={first.alt}
        width={first.w}
        height={first.h}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      <span class="spot-vignette" aria-hidden="true" />
      <span class="spot-ring" aria-hidden="true" />
      <span class="spot-chip" aria-hidden="true">
        <b>01</b>
        <span>{first.label}</span>
      </span>
      {data.length > 1 && (
        <span class="spot-dots" aria-hidden="true">
          {data.map((_, i) => (
            <i class:list={{ on: i === 0 }} />
          ))}
        </span>
      )}
    </div>
  ) : (
    <ProjectVisual slug={slug} title={title} pattern={pattern} seed={seed} eager={eager} />
  )
}

<style>
  .spot {
    --sx: 50%;
    --sy: 40%;
    --sr: 0px;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--color-surface);
    isolation: isolate;
  }

  .spot-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Without the script: the full screenshot, still. */
  .spot-base,
  .spot-vignette,
  .spot-ring,
  .spot-chip,
  .spot-dots {
    display: none;
  }

  .spot[data-live] {
    cursor: crosshair;
  }

  .spot[data-live] .spot-base {
    display: block;
    filter: grayscale(1) brightness(0.2) contrast(1.05);
  }

  .spot[data-live] .spot-lit {
    filter: brightness(0.93) saturate(1.05);
    -webkit-mask-image: radial-gradient(circle var(--sr) at var(--sx) var(--sy), #000 86%, transparent 100%);
    mask-image: radial-gradient(circle var(--sr) at var(--sx) var(--sy), #000 86%, transparent 100%);
  }

  .spot[data-live] .spot-vignette {
    display: block;
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 90% at 50% 40%, transparent 55%, rgb(0 0 0 / 0.5) 100%);
  }

  .spot[data-live] .spot-ring {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--sr) * 2);
    height: calc(var(--sr) * 2);
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-trace) 55%, transparent);
    transform: translate(calc(var(--sx) - var(--sr)), calc(var(--sy) - var(--sr)));
    pointer-events: none;
  }

  .spot[data-live] .spot-chip {
    display: flex;
    position: absolute;
    left: 0;
    top: 0;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem 0.375rem 0.5rem;
    border-radius: 999px;
    background: var(--color-trace);
    color: var(--color-bg);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 350ms var(--ease-out);
  }

  .spot[data-live][data-label] .spot-chip {
    opacity: 1;
  }

  .spot-chip b {
    display: grid;
    place-items: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.25rem;
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-trace);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
  }

  .spot[data-live] .spot-dots {
    display: flex;
    position: absolute;
    right: 0.875rem;
    bottom: 0.875rem;
    gap: 0.375rem;
    pointer-events: none;
  }

  .spot-dots i {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.25);
    transition:
      background-color 300ms var(--ease-out),
      width 300ms var(--ease-out);
  }

  .spot-dots i.on {
    width: 18px;
    background: var(--color-trace);
  }
</style>
