---
// Static relief drawing of a generative pattern. Decorative: callers give it meaning via a caption or alt.
import { reliefSvgPaths } from '@/lib/patterns';

interface Props {
  pattern: number;
  seed?: number;
  width?: number;
  height?: number;
  lines?: number;
  label?: string;
}
const { pattern, seed = 0, width = 800, height = 500, lines = 26, label } = Astro.props;
const paths = reliefSvgPaths(pattern, seed, width, height, lines);
---

<svg
  class="relief"
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  role={label ? 'img' : 'presentation'}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {
    paths.map((p) => (
      <g>
        <path class="occlude" d={p.fill} />
        <path class="line" d={p.d} />
      </g>
    ))
  }
</svg>

<style>
  .relief {
    display: block;
    width: 100%;
    height: 100%;
  }

  .occlude {
    fill: var(--relief-bg, var(--color-bg));
    stroke: none;
  }

  .line {
    fill: none;
    stroke: var(--relief-ink, var(--color-ink-muted));
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
</style>
