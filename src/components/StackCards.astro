---
// Featured projects as full-width cards that stack while scrolling. Stacking is plain CSS sticky,
// so it works without JavaScript; motion/scenes.ts adds the settle-back (scale, tilt, shade).
// The art is a WebGL plate (data-plate-track) with the same finish as the project's 3D card.
import Relief from './Relief.astro';
import Todo from './Todo.astro';
import { patternFor, seedFor, STATUS_LABEL, toneFor, type Project } from '@/lib/projects';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(projects.length);
---

<ol class="stack" role="list" data-stack>
  {
    projects.map((p, i) => {
      const d = p.data;
      const tone = toneFor(i);
      const href = `/work/${p.id}/`;
      return (
        <li class="stack-card" data-stack-card data-index={i} style={`--i:${i}`}>
          <article class="inner" data-stack-inner data-plate-host aria-labelledby={`stack-${p.id}`}>
            <div class="text">
              <p class="label">
                {pad(i + 1)} / {total} · {STATUS_LABEL[d.status.value]} <Todo when={d.status.placeholder} />
              </p>
              <h3 id={`stack-${p.id}`}>
                <a href={href} class="title-link">
                  {d.title}
                </a>
              </h3>
              <p class="summary">
                {d.summary.value} <Todo when={d.summary.placeholder} />
              </p>
              <p class="meta mono">
                {d.stack.value.slice(0, 4).join(' / ')} <Todo when={d.stack.placeholder} />
              </p>
              <span class="cta mono" aria-hidden="true">
                Case study <span class="arrow">→</span>
              </span>
            </div>
            <figure
              class="art"
              data-plate
              data-plate-track
              data-pattern={patternFor(p)}
              data-seed={seedFor(p).toFixed(3)}
              data-base={tone.base}
              data-line={tone.line}
              style={`--relief-bg:${tone.base};--relief-ink:${tone.line}`}
            >
              <div class="frame">
                <Relief
                  pattern={patternFor(p)}
                  seed={seedFor(p)}
                  label={`Generative relief cover for ${d.title}. Not a screenshot.`}
                />
              </div>
            </figure>
            <span class="shade" data-stack-shade aria-hidden="true" />
          </article>
        </li>
      );
    })
  }
</ol>

<style>
  .stack {
    display: grid;
    gap: 6vh;
    padding-bottom: 12vh;
  }

  .stack-card {
    position: sticky;
    top: calc(var(--header-h) + 3vh + var(--i) * 14px);
    perspective: 1400px;
  }

  .inner {
    position: relative;
    display: grid;
    gap: var(--space-5);
    min-height: min(78svh, 46rem);
    padding: clamp(var(--space-5), 3vw, var(--space-7));
    border-radius: var(--radius-card);
    background: var(--night-raised);
    border: 1px solid var(--night-rule);
    /* Gloss: a one-pixel highlight along the top edge, like light catching a lacquered panel. */
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      0 30px 60px -30px rgb(0 0 0 / 0.6);
    transform-origin: 50% 0%;
    overflow: hidden;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
    z-index: 1;
  }

  h3 {
    font-size: clamp(2.25rem, 5vw, 4.75rem);
    line-height: var(--leading-display);
    font-weight: 700;
  }

  .title-link {
    text-decoration: none;
  }

  /* The whole card is the target: the title link stretches over it. */
  .title-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--radius-card);
  }

  .title-link:focus-visible {
    outline: none;
  }

  .title-link:focus-visible::after {
    outline: var(--focus-ring);
    outline-offset: 4px;
  }

  .summary {
    font-size: var(--text-lead);
    line-height: 1.35;
    max-width: 30ch;
  }

  .meta {
    color: var(--color-ink-muted);
  }

  .cta {
    margin-top: auto;
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
  }

  .arrow {
    display: inline-block;
    transition: transform var(--dur-med) var(--ease-out);
  }

  @media (hover: hover) {
    .inner:hover .arrow {
      transform: translateX(6px);
    }
  }

  .art {
    margin: 0;
    align-self: stretch;
  }

  .frame {
    position: relative;
    height: 100%;
    min-height: 14rem;
    border-radius: calc(var(--radius-card) * 0.7);
    overflow: hidden;
    background: var(--relief-bg);
  }

  :global(html[data-plates='live']) .frame {
    background: transparent;
  }

  :global(html[data-plates='live']) .frame :global(.relief) {
    opacity: 0;
  }

  .shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--night);
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 56rem) {
    .inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(var(--space-6), 4vw, var(--space-8));
    }
  }
</style>
