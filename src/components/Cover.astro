---
// Project cover. With WebGL, the overlay layer draws a glossy relief plate exactly over this box
// (data-plate): it tilts toward the pointer and bends with scroll speed, and plays the project's
// motion graphic over its real screenshots. Without WebGL, the first screenshot (or a generated
// relief when there are none) is the cover.
import ProjectVisual from './ProjectVisual.astro';
import type { Tone } from '@/lib/tones';

interface Props {
  title: string;
  slug: string;
  pattern: number;
  seed: number;
  tone: Tone;
  size?: 'feature' | 'hero';
}
const { title, slug, pattern, seed, tone, size = 'feature' } = Astro.props;
---

<figure
  class:list={['cover', size]}
  data-plate
  data-plate-host
  data-slug={slug}
  data-pattern={pattern}
  data-seed={seed.toFixed(3)}
  data-base={tone.base}
  data-line={tone.line}
  data-accent={tone.accent}
  style={`--relief-bg:${tone.base};--relief-ink:${tone.line}`}
>
  <div class="frame">
    <ProjectVisual slug={slug} title={title} pattern={pattern} seed={seed} eager={size === 'hero'} />
  </div>
  <slot />
</figure>

<style>
  .cover {
    position: relative;
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--relief-bg);
  }

  .hero .frame {
    aspect-ratio: 21 / 9;
  }

  /* Live: the WebGL plate draws over this box, so the SVG steps aside. */
  :global(html[data-plates='live']) .frame :global(.relief) {
    opacity: 0;
  }

  @media (max-width: 40rem) {
    .hero .frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
