---
// Project cover. With WebGL, the overlay layer draws a glossy relief plate exactly over this box
// (data-plate): it tilts toward the pointer, ripples on press, and bends with scroll speed.
// Without WebGL, the SVG relief inside is the cover. Generated, never stock or AI imagery.
import Relief from './Relief.astro';
import type { Tone } from '@/lib/tones';

interface Props {
  title: string;
  pattern: number;
  seed: number;
  tone: Tone;
  size?: 'feature' | 'hero';
}
const { title, pattern, seed, tone, size = 'feature' } = Astro.props;
---

<figure
  class:list={['cover', size]}
  data-plate
  data-plate-host
  data-pattern={pattern}
  data-seed={seed.toFixed(3)}
  data-base={tone.base}
  data-line={tone.line}
  style={`--relief-bg:${tone.base};--relief-ink:${tone.line}`}
>
  <div class="frame">
    <Relief pattern={pattern} seed={seed} label={`Generative relief cover for ${title}. Not a screenshot.`} />
  </div>
  <slot />
</figure>

<style>
  .cover {
    position: relative;
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--relief-bg);
  }

  .hero .frame {
    aspect-ratio: 21 / 9;
  }

  /* Live: the WebGL plate draws over this box, so the SVG steps aside. */
  :global(html[data-plates='live']) .frame :global(.relief) {
    opacity: 0;
  }

  @media (max-width: 40rem) {
    .hero .frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
