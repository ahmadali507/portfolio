---
// Project cover. With WebGL, the engine draws a shaded relief plane exactly over this box
// (data-plate) that tilts toward the pointer, ripples on hover, and bends with scroll speed.
// Without WebGL, the SVG relief inside is the cover. Generated, never stock or AI imagery.
import Relief from './Relief.astro';

interface Props {
  title: string;
  pattern: number;
  seed: number;
  size?: 'feature' | 'hero';
  eager?: boolean;
}
const { title, pattern, seed, size = 'feature' } = Astro.props;
---

<figure
  class:list={['cover', size]}
  data-plate
  data-pattern={pattern}
  data-seed={seed.toFixed(3)}
  data-world-anchor={`cover-${pattern}`}
>
  <div class="frame">
    <Relief pattern={pattern} seed={seed} label={`Generative relief cover for ${title}. Not a screenshot.`} />
  </div>
  <slot />
</figure>

<style>
  .cover {
    position: relative;
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface);
    --relief-bg: var(--color-surface);
    transition: opacity 500ms var(--ease-out);
  }

  .hero .frame {
    aspect-ratio: 21 / 9;
  }

  /* Live: the WebGL plane draws here, so the box turns into a clear window onto the canvas. */
  :global(html[data-plates='live']) .frame {
    background: transparent;
  }

  :global(html[data-plates='live']) .frame :global(.relief) {
    opacity: 0;
  }

  @media (max-width: 40rem) {
    .hero .frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
