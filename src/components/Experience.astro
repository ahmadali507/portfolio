---
// Experience: three chapters under one line. The line fills as the section scrolls into view
// (motion/scenes.ts). Without JavaScript or under reduced motion the line is simply full.
import Todo from './Todo.astro';
import { EXPERIENCE } from '@/config/experience';
---

<section class="xp" id="experience" aria-labelledby="xp-title">
  <div class="page xp-in">
    <header class="sec-head">
      <p class="label">Experience</p>
      <h2 class="sec-title" id="xp-title" data-slide><span class="dim">The path</span><span>so far</span></h2>
    </header>

    <div class="xp-body">
      <div class="xp-line" aria-hidden="true"><span data-grow></span></div>
      <ol class="xp-list" role="list">
        {
          EXPERIENCE.map((x) => (
            <li class="xp-item" data-rise>
              <p class="label xp-when">
                {x.when.value} {x.when.flag && <Todo text={x.when.flag} />}
              </p>
              <h3>{x.org}</h3>
              <p class="label xp-role">{x.role}</p>
              <p class="xp-sum">{x.summary}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .xp {
    position: relative;
    z-index: 2;
    background: var(--color-bg);
    border-top: var(--hairline);
    overflow-x: clip;
  }

  .xp-in {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-9);
  }

  .xp-body {
    display: grid;
    gap: var(--space-6);
  }

  .xp-line {
    position: relative;
    height: 2px;
    background: var(--color-rule);
  }

  .xp-line span {
    position: absolute;
    inset: 0;
    background: var(--color-trace);
    transform-origin: 0 50%;
  }

  .xp-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-7) var(--space-6);
  }

  .xp-item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  .xp-when {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-trace-ink);
  }

  .xp-item h3 {
    font-size: clamp(1.375rem, 2.05vw, 1.85rem);
    overflow-wrap: break-word;
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .xp-role {
    color: var(--color-ink-muted);
  }

  .xp-sum {
    margin-top: var(--space-2);
    max-width: 19rem;
    color: var(--color-ink-muted);
  }
</style>
