---
// Experience: three chapters on one rail, oldest first. The rail fills as the reader scrolls and
// each chapter's marker lights when it is reached (motion/scenes.ts). Without JavaScript or under
// reduced motion it is a plain ordered list with everything visible.
import SplitWords from './SplitWords.astro';
import Todo from './Todo.astro';
import { EXPERIENCE } from '@/config/experience';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="xp" id="experience" aria-labelledby="xp-title" data-xp>
  <div class="page">
    <header class="xp-head">
      <p class="label">Experience</p>
      <SplitWords as="h2" id="xp-title" text="Freelancer. Engineer. Founder." />
    </header>

    <div class="xp-track" data-xp-list>
      <span class="xp-rail" aria-hidden="true"><span class="xp-fill" data-xp-fill></span></span>
      <ol class="xp-list" role="list">
      {
        EXPERIENCE.map((x, i) => (
          <li class="xp-item" data-xp-item>
            <span class="xp-node" aria-hidden="true" />
            <div class="xp-when">
              <p class="mono xp-n">{pad(i + 1)}</p>
              <p class="label xp-period">
                {x.when.value} {x.when.flag && <Todo text={x.when.flag} />}
              </p>
              <p class="label xp-place">{x.place}</p>
            </div>
            <div class="xp-body" data-xp-body>
              <h3 class="xp-org">{x.org}</h3>
              <p class="mono xp-role">{x.role}</p>
              <p class="xp-sum">{x.summary}</p>
              <ul role="list" class="xp-points">
                {x.points.map((p) => (
                  <li>
                    {p.text}
                    {p.href && (
                      <a class="xp-link mono" href={p.href}>
                        {p.link} <span aria-hidden="true">→</span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
              <ul role="list" class="xp-tools" aria-label={`Tools used at ${x.org}`}>
                {x.tools.map((t) => (
                  <li class="mono">{t}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

<style>
  .xp {
    --col: 13rem;
    --gap: 5rem;
    position: relative;
    z-index: 2;
    background: var(--color-bg);
    padding-block: var(--space-9);
    border-top: var(--hairline);
  }

  .xp-head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .xp-head :global(h2) {
    font-size: clamp(2.5rem, 8vw, 8rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    max-width: 12ch;
  }

  .xp-track {
    position: relative;
  }

  .xp-list {
    display: grid;
    gap: var(--space-9);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The rail and its markers sit in one column: left edge on phones, between the columns on wide screens. */
  .xp-rail {
    position: absolute;
    top: 0.5rem;
    bottom: 0;
    left: 4px;
    width: 2px;
    background: var(--color-rule);
  }

  .xp-fill {
    position: absolute;
    inset: 0;
    background: var(--color-trace);
    transform-origin: 50% 0;
  }

  .xp-item {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-left: var(--space-6);
  }

  .xp-node {
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 10px;
    height: 10px;
    background: var(--color-bg);
    border: 2px solid var(--color-ink-muted);
    transition:
      background-color var(--dur-med) var(--ease-out),
      border-color var(--dur-med) var(--ease-out),
      transform 500ms var(--ease-expo);
  }

  .xp-item[data-on] .xp-node {
    background: var(--color-trace);
    border-color: var(--color-trace);
    transform: rotate(45deg) scale(1.15);
  }

  .xp-when {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .xp-n {
    color: var(--color-ink-muted);
  }

  .xp-period {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-ink);
  }

  .xp-place {
    color: var(--color-ink-muted);
  }

  .xp-body {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .xp-org {
    font-size: clamp(2.25rem, 6vw, 5.5rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .xp-role {
    color: var(--color-trace-ink);
  }

  .xp-sum {
    font-size: var(--text-lead);
    line-height: 1.4;
    max-width: 40ch;
  }

  .xp-points {
    display: grid;
    margin-top: var(--space-3);
    max-width: 64ch;
  }

  .xp-points li {
    padding-block: var(--space-3);
    border-top: var(--hairline);
    color: var(--color-ink-muted);
  }

  .xp-link {
    display: inline-flex;
    gap: var(--space-2);
    margin-left: var(--space-2);
    color: var(--color-ink);
    white-space: nowrap;
  }

  .xp-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .xp-tools li {
    padding: 0.3rem 0.65rem;
    border: var(--hairline);
    border-radius: 999px;
    font-size: var(--text-label);
    color: var(--color-ink-muted);
  }

  @media (min-width: 60rem) {
    .xp-item {
      grid-template-columns: var(--col) minmax(0, 1fr);
      column-gap: var(--gap);
      padding-left: 0;
    }

    .xp-rail {
      left: calc(var(--col) + var(--gap) / 2 - 1px);
    }

    .xp-node {
      left: calc(var(--col) + var(--gap) / 2 - 5px);
      top: 1.1rem;
    }

    .xp-when {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      padding-top: 0.9rem;
    }
  }
</style>
