---
// Static poster for the world: shown first, kept when WebGL is unavailable or fails.
// The home relief drawn as lines over the lower part of the screen. Decorative.
import Relief from './Relief.astro';
---

<div class="poster-relief">
  <Relief pattern={0} width={1440} height={620} lines={34} />
</div>

<style>
  .poster-relief {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 62%;
    --relief-ink: var(--color-rule);
  }
</style>
