---
import Base from '@/layouts/Base.astro';
import WorkGallery from '@/components/WorkGallery.astro';
import Experience from '@/components/Experience.astro';
import Testimonials from '@/components/Testimonials.astro';
import { FIRST_NAME, FULL_NAME, PERSON, ROLES, SURNAME } from '@/config/site';
import { visibleProjects } from '@/lib/projects';

const { featured, all } = await visibleProjects();
const pad = (n: number) => String(n).padStart(2, '0');

// What I build. Each area has one short line and the projects that prove it (docs/CONTENT.md).
// A project that is not visible is dropped from its row.
const titleOf = new Map(all.map((p) => [p.id, p.data.title]));
const areas = [
  { area: 'Full-stack SaaS', line: 'Roles, permissions, payments, live collaboration.', ids: ['vakse', 'codesmash', 'shocodoc'] },
  { area: 'Mobile apps', line: 'One codebase for iOS and Android.', ids: ['orderlyflow'] },
  { area: 'AI systems', line: 'Models inside products that must work every time.', ids: ['magicalbook-store', 'prepify', 'xiomara'] },
  { area: 'Cloud', line: 'Pipelines that run on schedule and recover from failure.', ids: ['scrape-stripe', 'searchx'] },
  { area: 'Automation', line: 'Payments, webhooks, and the tools a business already uses.', ids: ['vakse', 'menumatch'] },
].map((a) => ({ ...a, proofs: a.ids.filter((id) => titleOf.has(id)).map((id) => ({ id, title: titleOf.get(id) ?? '' })) }));
const firstRole = ROLES[0];
---

<Base page="home">
  <!-- The whole page shares one wrapper, so the trail line can run from under the header to the footer. -->
  <div class="trail-wrap" data-trail>
  <!-- 1. Hero: the name, one typed role at a time, and one floating object on a grid of cells. -->
  <section class="hero" aria-labelledby="hero-title" data-hero data-world-anchor="hero">
    <div class="page hero-in">
      <div class="hero-copy" data-hero-copy>
        <p class="label eyebrow enter" style="--d:120ms"><span class="sq" aria-hidden="true"></span>{PERSON.role}</p>
        <h1 id="hero-title" class="enter" style="--d:220ms" aria-label={FULL_NAME}>
          <span aria-hidden="true">{FIRST_NAME}</span>
          <span aria-hidden="true">{SURNAME}</span>
        </h1>

        <!-- The typed line is decoration for sighted readers; the list after it carries the same words for everyone. -->
        <p class="typed enter" style="--d:420ms" aria-hidden="true" data-typed>
          <span class="typed-text" data-typed-text
            ><span class="tw-adv">{firstRole.adv}</span> <span class="tw-role">{firstRole.role}</span></span
          ><span class="caret"></span>
        </p>
        <ul class="visually-hidden" role="list" data-roles>
          {ROLES.map((r) => <li data-role>{r.role}</li>)}
        </ul>

        <p class="lead enter" style="--d:560ms">{PERSON.positioning}</p>
        <div class="actions enter" style="--d:680ms">
          <a class="pill" href="#work" data-magnetic="0.15">See the work</a>
          <a class="under" href="/estimate/">Get an estimate</a>
        </div>
      </div>
    </div>
    <div class="page hero-foot label enter" style="--d:900ms">
      <span>Top Rated on Upwork</span>
      <span>{PERSON.location}</span>
      <span aria-hidden="true">Scroll</span>
    </div>
  </section>

  <!-- 2. A moving band of the five things he builds. Decoration: the list below says the same. -->
  <div class="band" aria-hidden="true">
    <div class="band-track">
      {
        [0, 1].map(() =>
          areas.map((a) => (
            <>
              <span>{a.area}</span>
              <i />
            </>
          )),
        )
      }
    </div>
  </div>

  <!-- 3. What I build: five cards that stack on top of each other as the reader scrolls. -->
  <section class="build" aria-labelledby="build-title">
    <div class="page build-in">
      <header class="sec-head">
        <p class="label">Capabilities</p>
        <h2 class="sec-title" id="build-title" data-slide><span class="dim">What I</span><span>build</span></h2>
      </header>
      <ol class="stack" role="list" data-stack>
        {
          areas.map((a, i) => (
            <li class="card" style={`--i:${i}`} data-stack-card>
              <div class="card-in" data-stack-face>
                <div class="card-top">
                  <span class="label n">
                    {pad(i + 1)} / {pad(areas.length)}
                  </span>
                  <ul class="chips" role="list" aria-label="Seen in">
                    {a.proofs.map((p) => (
                      <li>
                        <a href={`/work/${p.id}/`}>{p.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="card-main">
                  <h3>{a.area}</h3>
                  <p class="line">{a.line}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. Experience: three chapters under a line that fills with scroll. -->
  <Experience />

  <!-- 5. Projects: a pinned gallery. Scroll turns a spiral of glossy cards; each project swings to the front. -->
  <WorkGallery projects={featured} total={all.length} />

  <!-- 6. Reviews: a centred carousel of client quotes. -->
  <Testimonials />

  <!-- 7. The closing call to action. -->
  <section class="cta" aria-labelledby="cta-title">
    <div class="page cta-in">
      <h2 class="sec-title cta-title" id="cta-title" data-slide><span class="dim">Start a</span><span>project</span></h2>
      <div class="actions" data-rise>
        <a class="pill accent" href="/estimate/" data-magnetic="0.15">Get an estimate</a>
        <a class="under" href="/contact/">Or write to me</a>
      </div>
    </div>
  </section>
  </div>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    /* The layout already clears the fixed header, so the hero fills what is left of the screen. */
    min-height: max(calc(100svh - var(--header-h)), 38rem);
  }

  .hero-in {
    display: grid;
    align-items: center;
    width: 100%;
  }

  .hero-copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: 46rem;
    padding-block: var(--space-7);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink-muted);
  }

  .sq {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-trace);
  }

  h1 {
    font-size: clamp(3.25rem, 8vw, 7.25rem);
    font-weight: 800;
    line-height: 0.9;
    text-transform: uppercase;
  }

  h1 span {
    display: block;
  }

  /* The typed line: one row of capitals, the adverb in the accent, the role in ink. */
  .typed {
    min-height: 2.6em;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2vw, 1.625rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .typed :global(.tw-adv) {
    color: var(--color-trace-ink);
  }

  .typed :global(.tw-word) {
    display: inline-block;
    white-space: nowrap;
  }

  .typed :global(.tw) {
    white-space: pre;
  }

  .typed[data-selected] .typed-text {
    background: var(--color-trace-deep);
    box-shadow: 0 0 0 0.12em var(--color-trace-deep);
  }

  .caret {
    display: inline-block;
    width: 0.12em;
    min-width: 2px;
    height: 0.95em;
    margin-left: 0.25em;
    vertical-align: -0.1em;
    background: var(--color-trace);
  }

  @media (prefers-reduced-motion: no-preference) {
    .typed:not([data-busy]) .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .lead {
    max-width: 27rem;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-2);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: var(--space-6);
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color var(--dur-med) var(--ease-out),
      color var(--dur-med) var(--ease-out);
  }

  .pill:hover {
    background: var(--color-trace);
    color: var(--color-bg);
  }

  .pill.accent {
    background: var(--color-trace);
  }

  .pill.accent:hover {
    background: var(--color-ink);
  }

  .under {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-underline-offset: 0.5em;
    text-decoration-color: var(--color-trace);
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    width: 100%;
    padding-block: var(--space-5);
    color: var(--color-ink-muted);
  }

  /* On tall screens the object floats above the name, so the copy sits low. */
  @media (max-aspect-ratio: 9 / 10) {
    .hero-in {
      align-items: end;
    }

    .hero-copy {
      padding-top: 38svh;
    }
  }

  /* ---------- band ---------- */
  .trail-wrap {
    position: relative;
  }

  .band {
    position: relative;
    display: flex;
    align-items: center;
    height: clamp(5.5rem, 10vw, 9.5rem);
    overflow: hidden;
    background: var(--color-bg);
    border-block: var(--hairline);
  }

  .band-track {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    padding-left: var(--space-7);
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-ink-muted);
  }

  .band-track i {
    flex: none;
    width: 0.22em;
    height: 0.22em;
    background: var(--color-trace);
  }

  @media (prefers-reduced-motion: no-preference) {
    .band-track {
      animation: band 38s linear infinite;
    }
  }

  @keyframes band {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- what I build ---------- */
  .build,
  .cta {
    position: relative;
    background: var(--color-bg);
    overflow-x: clip;
  }

  .build-in {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-9);
  }

  /* Each card sticks a little lower than the one before it, so they pile up as the page scrolls.
     motion/scenes.ts shrinks and dims the cards underneath; without it they still stack. */
  .stack {
    display: grid;
    gap: var(--space-6);
  }

  .card {
    position: sticky;
    top: calc(var(--header-h) + var(--space-5) + var(--i) * 1.15rem);
  }

  .card-in {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: var(--space-7);
    min-height: clamp(17rem, 50svh, 26rem);
    padding: clamp(1.5rem, 4vw, 3.25rem);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    transform-origin: 50% 0;
    overflow: hidden;
  }

  /* A veil that darkens a card as the next ones cover it. */
  .card-in::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    opacity: var(--veil, 0);
    pointer-events: none;
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
  }

  .card-top .n {
    color: var(--color-trace-ink);
  }

  .card-main {
    display: grid;
    gap: var(--space-4) var(--space-7);
    align-items: end;
  }

  .card h3 {
    font-size: clamp(2rem, 4.6vw, 4rem);
    font-weight: 800;
    line-height: 0.95;
    overflow-wrap: normal;
  }

  .card .line {
    max-width: 26rem;
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--color-ink-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chips a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    font-size: var(--text-label);
    color: var(--color-ink-muted);
    text-decoration: none;
    transition:
      border-color var(--dur-med) var(--ease-out),
      color var(--dur-med) var(--ease-out);
  }

  .chips a:hover {
    border-color: var(--color-trace);
    color: var(--color-ink);
  }

  @media (min-width: 62rem) {
    .card-main {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }

    .card .line {
      justify-self: end;
    }
  }

  /* ---------- closing call to action ---------- */
  .cta {
    border-top: var(--hairline);
  }

  .cta-in {
    display: grid;
    gap: var(--space-7);
    justify-items: start;
    padding-block: var(--space-9);
  }

  .cta-title {
    font-size: clamp(2.5rem, 9.6vw, 8.5rem);
  }
</style>
