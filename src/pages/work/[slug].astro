---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Cover from '@/components/Cover.astro';
import Todo from '@/components/Todo.astro';
import {
  hasPlaceholders,
  patternFor,
  seedFor,
  STATUS_LABEL,
  visibleProjects,
  type Project,
} from '@/lib/projects';

export async function getStaticPaths() {
  const { all } = await visibleProjects();
  return all.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      index,
      prev: all[index - 1] ?? null,
      next: all[index + 1] ?? null,
      total: all.length,
    },
  }));
}

interface Props {
  project: Project;
  index: number;
  prev: Project | null;
  next: Project | null;
  total: number;
}

const { project, index, prev, next, total } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const pattern = patternFor(project);
const seed = seedFor(project);
const pad = (n: number) => String(n).padStart(2, '0');
const draft = hasPlaceholders(project);
---

<Base
  page="case"
  slug={project.id}
  pattern={pattern}
  seed={seed}
  title={d.title}
  description={`${d.title}: ${d.summary.value}`}
>
  <article class="page case" aria-labelledby="case-title">
    <header class="head" data-world-stage>
      <div class="head-text" data-world-zone>
        <p class="label">
          <a href="/work/">Work</a> / Case study {pad(index + 1)} of {pad(total)}
        </p>
        <h1 id="case-title">{d.title}</h1>
        <p class="lead">
          {d.summary.value} <Todo when={d.summary.placeholder} />
        </p>
        {draft && (
          <p class="draft">
            <span class="placeholder-flag">Draft</span> Fields marked TODO hold placeholder text.
            They are not facts about this project yet.
          </p>
        )}
      </div>
    </header>

    <dl class="spec ground">
      <div>
        <dt class="label">Role</dt>
        <dd>
          {d.role.value} <Todo when={d.role.placeholder} />
        </dd>
      </div>
      <div>
        <dt class="label">Year</dt>
        <dd class="mono">
          {d.year.value} <Todo when={d.year.placeholder} />
        </dd>
      </div>
      <div>
        <dt class="label">Status</dt>
        <dd>
          {STATUS_LABEL[d.status.value]} <Todo when={d.status.placeholder} />
        </dd>
      </div>
      <div class="wide">
        <dt class="label">Stack</dt>
        <dd class="mono">
          {d.stack.value.join(' / ')} <Todo when={d.stack.placeholder} />
        </dd>
      </div>
    </dl>

    <Cover title={d.title} pattern={pattern} seed={seed} size="hero">
      <figcaption class="label caption">
        Generative cover, drawn from code for this page.{' '}
        <Todo when={d.media.placeholder} text="Placeholder media" />
      </figcaption>
    </Cover>

    <div class="body ground">
      <section aria-labelledby="problem-title">
        <h2 id="problem-title">Problem</h2>
        <p>
          {d.problem.value} <Todo when={d.problem.placeholder} />
        </p>
      </section>
      <section aria-labelledby="approach-title">
        <h2 id="approach-title">Approach</h2>
        <div class="prose">
          <Content />
        </div>
        <Todo when={d.placeholder} text="Placeholder narrative" />
      </section>
      <section aria-labelledby="outcome-title">
        <h2 id="outcome-title">Outcome</h2>
        <p>
          {d.outcome.value} <Todo when={d.outcome.placeholder} />
        </p>
      </section>
      {d.links.length > 0 && (
        <section aria-labelledby="links-title">
          <h2 id="links-title">Links</h2>
          <ul role="list" class="links">
            {d.links.map((l) => (
              <li>
                <a href={l.url}>{l.label}</a> <Todo when={l.placeholder} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <nav class="pager ground" aria-label="More case studies">
      {prev ? (
        <a href={`/work/${prev.id}/`} rel="prev">
          <span class="label">Previous</span>
          <span class="t">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={`/work/${next.id}/`} rel="next" class="next">
          <span class="label">Next</span>
          <span class="t">{next.data.title}</span>
        </a>
      ) : (
        <a href="/work/" class="next">
          <span class="label">Back to</span>
          <span class="t">All work</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  .head {
    display: grid;
    align-content: end;
    min-height: clamp(20rem, 52svh, 32rem);
    padding-block: var(--space-8) var(--space-6);
  }

  .head-text {
    max-width: 52rem;
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--leading-display);
    margin-block: var(--space-4) var(--space-5);
  }

  .lead {
    max-width: 40ch;
  }

  .draft {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .spec {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--rule-strong);
    margin-bottom: var(--space-7);
  }

  .spec div {
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: var(--hairline);
  }

  .spec .wide {
    grid-column: 1 / -1;
  }

  .spec dd {
    margin-top: var(--space-1);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-bottom: var(--hairline);
  }

  @media (min-width: 56rem) {
    .spec {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .spec div {
      padding-left: var(--space-3);
      border-right: var(--hairline);
    }

    .spec div:first-child,
    .spec .wide {
      padding-left: 0;
    }

    .spec div:nth-child(3),
    .spec .wide {
      border-right: 0;
    }
  }

  .body {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-8);
    max-width: 44rem;
  }

  .body h2 {
    font-size: var(--text-h3);
    margin-bottom: var(--space-3);
  }

  .prose :global(p + p) {
    margin-top: var(--space-4);
  }

  .links {
    display: grid;
    gap: var(--space-2);
  }

  .links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    border-top: var(--rule-strong);
    padding-block: var(--space-5) var(--space-8);
  }

  .pager a {
    display: grid;
    gap: var(--space-1);
    text-decoration: none;
    min-height: 44px;
  }

  .pager .next {
    text-align: right;
  }

  .pager .t {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h3);
    line-height: 1.1;
  }

  @media (hover: hover) {
    .pager a:hover .t {
      text-decoration: underline;
      text-decoration-color: var(--color-trace);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.2em;
    }
  }
</style>
